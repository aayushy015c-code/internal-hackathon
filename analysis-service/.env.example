# .env.example - copy this to a real file named ".env" in this same folder.
# ".env" is git-ignored on purpose (see .gitignore) - it's where any local
# secrets or machine-specific settings live, never committed.
#
# Nothing here is a real secret for this project (the only real secret,
# ntfy topic names, lives in the core API's database), but this is the
# pattern to follow if you add an API key later.

# Where the Spring Boot core API is running.
CORE_API_URL=http://localhost:8080

# When true, /analyze skips decoding/whisper/librosa entirely and returns a
# hardcoded score. This is what makes "Step 1: skeleton" possible before
# faster-whisper and librosa are even installed - see BUILD_ORDER.md.
STUB_MODE=false
