# Copy this file to ".env" (same folder) and change the values.
# .env is in .gitignore, never put it on GitHub.

# Database encryption passwords (use long random strings, no spaces).
# If you change or lose these, the old database can't be opened.
DB_FILE_PASSWORD=change-me-file-password
DB_PASSWORD=change-me-user-password

# Optional: ntfy access token (only needed for a protected/self-hosted ntfy server)
NTFY_TOKEN=
# NTFY_BASE_URL=https://ntfy.sh

# Optional: public tunnel URL so the "Acknowledge" link works on contacts' phones
# APP_BASE_URL=https://your-tunnel.trycloudflare.com
