# Settings for Docker (docker compose reads this file automatically).
# Copy it:  cp .env.example .env   then replace the REPLACE_ME values.
# .env is in .gitignore, never put it on GitHub.

# Database password (any long random text).   Make one:  openssl rand -hex 24
POSTGRES_PASSWORD=REPLACE_ME

# Key that encrypts names, code words, location etc. in the database.
# Make one:  openssl rand -base64 32
# Keep a copy somewhere safe. If you lose it, saved data can't be read.
DATA_ENCRYPTION_KEY=REPLACE_ME

# Optional: ntfy access token (for a protected / self-hosted ntfy server)
NTFY_TOKEN=

# Optional: true = fake scores, no speech model (fast start for testing the website)
STUB_MODE=false
